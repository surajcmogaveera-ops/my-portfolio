# Copy to .env for the API process. Never commit real values.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Generate an scrypt hash with: npm run admin:hash
ADMIN_PASSWORD_HASH=replace_with_salt_and_hash_from_admin_hash_command

# Generate a random value with Node crypto; use at least 32 random bytes.
SESSION_SECRET=replace_with_a_random_64_character_hex_secret

# For a separately hosted frontend, set its API base URL at build time.
# VITE_API_URL=https://your-api-host.example/api
